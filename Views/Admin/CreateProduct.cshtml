@model ProductViewModel
@{
    ViewData["Title"] = "Thêm Mới Sản Phẩm";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">➕ Thêm Mới Sản Phẩm</h3>
                    <p class="text-muted small mb-0">Nhập thông tin sản phẩm</p>
                </div>
                <a asp-action="Products" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <form asp-action="CreateProduct" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Brand" class="form-label fw-semibold"></label>
                        <input asp-for="Brand" class="form-control" placeholder="Ví dụ: Apple, Sony" />
                        <span asp-validation-for="Brand" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label fw-semibold"></label>
                        <input asp-for="Price" type="number" step="10000" class="form-control" placeholder="Ví dụ: 25000000" />
                        <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OriginalPrice" class="form-label fw-semibold"></label>
                        <input asp-for="OriginalPrice" type="number" step="10000" class="form-control" placeholder="Giá gốc" />
                        <span asp-validation-for="OriginalPrice" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="Biểu tượng emoji hoặc URL" />
                        <span asp-validation-for="ImageUrl" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Badge" class="form-label fw-semibold"></label>
                        <input asp-for="Badge" class="form-control" placeholder="HOT, NEW, SALE" />
                        <span asp-validation-for="Badge" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-3 d-flex align-items-center mt-4">
                        <div class="form-check">
                            <input asp-for="InStock" class="form-check-input" />
                            <label asp-for="InStock" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Products" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        💾 Lưu Sản Phẩm Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
