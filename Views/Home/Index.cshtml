@model List<Product>
@{
    ViewData["Title"] = "Trang Chủ - Cửa Hàng Công Nghệ";
    var categories = ViewBag.Categories as List<Category> ?? new();
}

<div class="p-5 mb-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-3">🔥 XU THẾ CÔNG NGHỆ 2026</span>
            <h1 class="display-4 fw-extrabold mb-3">Trải Nghiệm Mua Sắm Chuẩn Kiến Trúc MVC</h1>
            <p class="lead text-white-50 mb-4">
                Hệ thống bán hàng trực tuyến với phân quyền người dùng, giỏ hàng phiên làm việc và xác thực dữ liệu đầy đủ.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-4">
                    🛍️ Khám Phá Sản Phẩm
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-light btn-lg px-4">
                        ⚙️ Vào Trang Quản Trị Admin
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4">
                        🔐 Đăng Nhập Phân Quyền
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <div class="display-1">💻📱🎧</div>
        </div>
    </div>
</div>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">📁 Danh Mục Sản Phẩm (@categories.Count danh mục)</h4>
        <a asp-controller="Product" asp-action="Index" class="text-decoration-none small fw-bold">Xem tất cả &rarr;</a>
    </div>

    <div class="row row-cols-2 row-cols-md-5 g-3">
        @foreach (var c in categories)
        {
            <div class="col">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm rounded-3 text-center p-3 hover-lift bg-white">
                        <div class="fs-1 mb-2">@(c.Icon ?? "📁")</div>
                        <h6 class="fw-bold mb-1 text-truncate" title="@c.Name">@c.Name</h6>
                        <small class="text-muted">Xem sản phẩm</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">⭐ Sản Phẩm Tiêu Biểu</h4>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">Xem toàn bộ kho hàng</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column bg-white">
                    <div class="p-4 text-center position-relative" style="background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%); min-height: 160px;">
                        <span class="badge bg-danger position-absolute top-0 end-0 m-3">@p.Badge</span>
                        <div class="display-3">@(p.ImageUrl ?? "📱")</div>
                    </div>
                    
                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <small class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem;">@(p.CategoryEntity?.Name ?? p.Category)</small>
                        <h6 class="card-title fw-bold text-dark mb-2 text-truncate-2" title="@p.Name">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                @p.Name
                            </a>
                        </h6>
                        <div class="mt-auto">
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                <span class="fs-5 fw-bold text-danger">@p.Price.ToString("N0") đ</span>
                                @if (p.OriginalPrice > p.Price)
                                {
                                    <small class="text-muted text-decoration-line-through">@p.OriginalPrice.ToString("N0") đ</small>
                                }
                            </div>
                            <div class="d-grid gap-2">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-outline-primary w-100 btn-sm fw-semibold">
                                        🛒 Thêm vào giỏ
                                    </button>
                                </form>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn btn-light btn-sm text-muted">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .hover-lift {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.5rem;
    }
</style>
