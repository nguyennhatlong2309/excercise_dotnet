@model Product
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as List<Product> ?? new();
}

<div class="row g-4 mb-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white d-flex align-items-center justify-content-center" style="min-height: 380px;">
            <div class="display-1 mb-3">@(Model.ImageUrl ?? "📱")</div>
            <span class="badge bg-danger fs-6 px-3 py-2">@Model.Badge</span>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1">
                    @(Model.CategoryEntity?.Name ?? Model.Category)
                </span>
                <span class="text-warning fw-bold">⭐ @Model.Rating.ToString("F1") (@Model.ReviewCount đánh giá)</span>
            </div>

            <h2 class="fw-extrabold text-dark mb-2">@Model.Name</h2>
            <p class="text-muted small mb-3">Thương hiệu: <strong>@Model.Brand</strong> | Mã SP: #@Model.Id</p>

            <div class="p-3 rounded-3 mb-4" style="background-color: #f8fafc;">
                <div class="d-flex align-items-baseline gap-3">
                    <span class="display-6 fw-bold text-danger">@Model.Price.ToString("N0") đ</span>
                    @if (Model.OriginalPrice > Model.Price)
                    {
                        <span class="fs-5 text-muted text-decoration-line-through">@Model.OriginalPrice.ToString("N0") đ</span>
                        <span class="badge bg-success">Tiết kiệm @((Model.OriginalPrice - Model.Price).ToString("N0")) đ</span>
                    }
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold mb-2">Mô tả sản phẩm:</h6>
                <p class="text-secondary" style="line-height: 1.7;">@Model.Description</p>
            </div>

            <div class="mt-auto pt-3 border-top">
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="row g-2 align-items-center">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="col-auto">
                        <label class="form-label small fw-bold mb-0">Số lượng:</label>
                    </div>
                    <div class="col-auto">
                        <input type="number" name="quantity" value="1" min="1" max="99" class="form-control text-center" style="width: 80px;" />
                    </div>
                    <div class="col">
                        <button type="submit" class="btn btn-gradient w-100 py-2 fs-6">
                            🛒 Thêm Vào Giỏ Hàng
                        </button>
                    </div>
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (related.Any())
{
    <section class="mt-5">
        <h4 class="fw-bold mb-3">🔗 Sản Phẩm Cùng Danh Mục</h4>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var p in related)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                        <div class="display-4 my-2">@(p.ImageUrl ?? "📱")</div>
                        <h6 class="fw-bold text-truncate mb-1">
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">@p.Name</a>
                        </h6>
                        <span class="fw-bold text-danger mb-2">@p.Price.ToString("N0") đ</span>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm mt-auto">Xem chi tiết</a>
                    </div>
                </div>
            }
        </div>
    </section>
}
