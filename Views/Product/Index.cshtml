@model List<Product>
@{
    ViewData["Title"] = "Cửa Hàng Sản Phẩm";
    var categories = ViewBag.Categories as List<Category> ?? new();
    int? selectedCategory = ViewBag.SelectedCategory as int?;
    string? searchKeyword = ViewBag.SearchKeyword as string;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-1">🛍️ Danh Sách Sản Phẩm</h2>
        <p class="text-muted">Tìm thấy <strong>@Model.Count</strong> sản phẩm phù hợp</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white sticky-top" style="top: 80px;">
            <h5 class="fw-bold mb-3">🔍 Bộ Lọc Tìm Kiếm</h5>
            
            <form asp-action="Index" method="get">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Từ khóa:</label>
                    <input type="text" name="search" value="@searchKeyword" class="form-control form-control-sm" placeholder="Tìm tên sản phẩm..." />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Danh mục:</label>
                    <select name="categoryId" class="form-select form-select-sm">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(selectedCategory == c.Id)">@c.Icon @c.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Mức giá tối đa (VNĐ):</label>
                    <input type="number" name="maxPrice" value="@maxPrice" step="1000000" class="form-control form-control-sm" placeholder="Ví dụ: 30000000" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Áp Dụng Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Đặt Lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-9">
        @if (!Model.Any())
        {
            <div class="alert alert-warning text-center py-5 rounded-4 shadow-sm">
                <div class="display-4 mb-3">📦</div>
                <h5>Không tìm thấy sản phẩm nào!</h5>
                <p class="text-muted small">Hãy thử tìm với từ khóa khác hoặc bỏ các tiêu chí lọc.</p>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Xem tất cả sản phẩm</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @foreach (var p in Model)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column bg-white hover-shadow">
                            <div class="p-4 text-center position-relative" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); min-height: 160px;">
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3">@p.Badge</span>
                                <div class="display-4">@(p.ImageUrl ?? "📱")</div>
                            </div>

                            <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">@(p.CategoryEntity?.Name ?? p.Category)</small>
                                    <small class="text-warning fw-bold">⭐ @p.Rating.ToString("F1")</small>
                                </div>
                                <h6 class="card-title fw-bold text-dark mb-2 text-truncate-2" title="@p.Name">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                        @p.Name
                                    </a>
                                </h6>
                                <p class="small text-muted text-truncate mb-3" style="max-height: 38px;">@p.Description</p>
                                
                                <div class="mt-auto">
                                    <div class="d-flex align-items-baseline gap-2 mb-3">
                                        <span class="fs-5 fw-bold text-danger">@p.Price.ToString("N0") đ</span>
                                        @if (p.OriginalPrice > p.Price)
                                        {
                                            <small class="text-muted text-decoration-line-through">@p.OriginalPrice.ToString("N0") đ</small>
                                        }
                                    </div>
                                    <div class="d-grid gap-2">
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-outline-primary w-100 btn-sm fw-semibold">
                                                🛒 Thêm vào giỏ
                                            </button>
                                        </form>
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-light btn-sm text-muted">
                                            Chi tiết &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px -3px rgba(0,0,0,0.1) !important;
        transition: all 0.2s;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.5rem;
    }
</style>
