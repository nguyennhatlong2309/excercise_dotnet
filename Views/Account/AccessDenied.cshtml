@{
    ViewData["Title"] = "Không Có Quyền Truy Cập (403)";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
            <div class="display-1 text-danger mb-3">🚫</div>
            <h2 class="fw-bold text-danger mb-2">Truy Cập Bị Từ Chối (403 Forbidden)</h2>
            <p class="text-muted lead mb-4">
                Bạn không có quyền <strong>Admin</strong> để truy cập vào khu vực quản trị này. 
                Phiên làm việc hiện tại của bạn là quyền <strong>User</strong> thông thường.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                    🏠 Về Trang Chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2">
                    🔄 Đăng Nhập Tài Khoản Admin
                </a>
            </div>
        </div>
    </div>
</div>
