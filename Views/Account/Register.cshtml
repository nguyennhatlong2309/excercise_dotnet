@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-gradient text-white text-center py-4" style="background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);">
                <div class="fs-1 mb-2">📝</div>
                <h3 class="fw-bold mb-1">Đăng Ký Tài Khoản Mới</h3>
                <small class="text-white-50">Tạo tài khoản để trải nghiệm mua sắm tại Nexus Store</small>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control py-2" placeholder="Ví dụ: Nguyễn Văn An" />
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label fw-semibold"></label>
                            <input asp-for="UserName" class="form-control py-2" placeholder="Ví dụ: user_an" />
                            <span asp-validation-for="UserName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control py-2" placeholder="Ví dụ: an@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control py-2" placeholder="Địa chỉ giao hàng (tùy chọn)" />
                            <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" type="password" class="form-control py-2" placeholder="Tối thiểu 6 ký tự" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control py-2" placeholder="Nhập lại mật khẩu" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fs-6 rounded-3 mt-4" style="background: #0284c7; border: none;">
                        Tạo Tài Khoản Ngay ✨
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted">Đã có tài khoản? <a asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập tại đây</a></small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
