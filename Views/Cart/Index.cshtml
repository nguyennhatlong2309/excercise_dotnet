@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
    var totalPrice = Model.Sum(c => c.Total);
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-1">🛒 Giỏ Hàng</h2>
        <p class="text-muted">Quản lý các sản phẩm bạn đã chọn trước khi thanh toán</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
        <div class="display-1 text-muted mb-3">🛒</div>
        <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống!</h4>
        <p class="text-muted">Hãy dạo quanh cửa hàng và chọn những sản phẩm công nghệ yêu thích nhé.</p>
        <div class="mt-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-gradient px-4 py-2">
                🛍️ Tiếp Tục Mua Sắm
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th class="text-center" style="width: 140px;">Số lượng</th>
                                <th>Thành tiền</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="fs-2">@(item.ImageUrl ?? "📱")</span>
                                            <div>
                                                <h6 class="fw-bold mb-0">@item.ProductName</h6>
                                                <small class="text-muted">@item.Category</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">@item.Price.ToString("N0") đ</td>
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-1">
                                            <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="delta" value="-1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2">-</button>
                                            </form>
                                            <span class="fw-bold px-2">@item.Quantity</span>
                                            <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="delta" value="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2">+</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-danger">@item.Total.ToString("N0") đ</td>
                                    <td class="text-end pe-4">
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khỏi giỏ">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        &larr; Tiếp tục chọn hàng
                    </a>
                    <form asp-action="Clear" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?')">
                            Xóa toàn bộ giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                <h5 class="fw-bold mb-3">Tóm Tắt Đơn Hàng</h5>
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tổng số lượng:</span>
                    <span class="fw-bold">@Model.Sum(c => c.Quantity) món</span>
                </div>
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính:</span>
                    <span class="fw-semibold">@totalPrice.ToString("N0") đ</span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Phí vận chuyển:</span>
                    <span class="text-success fw-semibold">Miễn phí 🚚</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold fs-5">Tổng thanh toán:</span>
                    <span class="fw-extrabold fs-4 text-danger">@totalPrice.ToString("N0") đ</span>
                </div>

                <div class="d-grid gap-2">
                    <a asp-action="Checkout" class="btn btn-gradient py-2 fw-bold">
                        💳 Tiến Hành Thanh Toán
                    </a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <small class="text-muted text-center mt-1">
                            * Cần <a asp-controller="Account" asp-action="Login">đăng nhập</a> để hoàn tất đặt hàng.
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
}
