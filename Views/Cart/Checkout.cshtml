@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Xác Nhận Đặt Hàng";
    var totalPrice = Model.Sum(c => c.Total);
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold mb-3">📦 Xác Nhận Đơn Hàng & Thanh Toán</h3>
            <p class="text-muted small mb-4">Vui lòng kiểm tra lại thông tin người nhận và danh sách sản phẩm.</p>

            <div class="mb-4">
                <h6 class="fw-bold text-primary mb-2">👤 Thông tin khách hàng (Từ Phiên Đăng Nhập):</h6>
                <div class="p-3 bg-light rounded-3">
                    <p class="mb-1"><strong>Tài khoản:</strong> @User.Identity?.Name</p>
                    <p class="mb-0"><strong>Quyền hạn:</strong> @(User.IsInRole("Admin") ? "Admin" : "User")</p>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-2">📋 Danh sách sản phẩm đặt mua:</h6>
                <ul class="list-group list-group-flush border rounded-3">
                    @foreach (var item in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="fw-semibold">@item.ProductName</span>
                                <small class="text-muted d-block">Số lượng: @item.Quantity x @item.Price.ToString("N0") đ</small>
                            </div>
                            <span class="fw-bold text-danger">@item.Total.ToString("N0") đ</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-light">
                        <strong class="fs-5">Tổng tiền thanh toán:</strong>
                        <strong class="fs-4 text-danger">@totalPrice.ToString("N0") đ</strong>
                    </li>
                </ul>
            </div>

            <form asp-action="Checkout" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
                    <button type="submit" class="btn btn-success btn-lg px-4 fw-bold">
                        ✅ Hoàn Tất Đặt Hàng (COD)
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
