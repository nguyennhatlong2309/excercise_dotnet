@page "/"
@inject ProductService ProductService
@inject CartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Trang Chủ - NEXUS STORE</PageTitle>

<!-- Hero Section -->
<section class="hero-container">
    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-7">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-indigo-500 bg-opacity-10 border border-indigo-500 border-opacity-30 mb-3 text-indigo-300 small">
                <i class="bi bi-stars text-warning"></i>
                <span>Bộ sưu tập công nghệ Flagship 2026</span>
            </div>
            <h1 class="display-4 font-heading fw-extrabold text-white mb-3" style="line-height: 1.15;">
                Công Nghệ Đột Phá.<br />
                <span class="text-transparent bg-clip-text" style="background: linear-gradient(135deg, #818cf8 0%, #34d399 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Trải Nghiệm Khác Biệt.
                </span>
            </h1>
            <p class="lead text-muted mb-4 max-w-xl">
                Khám phá thế giới điện thoại, laptop và tai nghe cao cấp. Thiết kế tối giản, hiệu năng đỉnh cao và ưu đãi đặc quyền lên tới 25% tháng này.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a href="products" class="btn btn-accent btn-lg px-4 py-2.5 fs-6 shadow-lg">
                    <i class="bi bi-grid-fill me-1"></i> Khám phá sản phẩm
                </a>
                <a href="products?cat=Điện+thoại" class="btn btn-outline-custom btn-lg px-4 py-2.5 fs-6">
                    <i class="bi bi-phone me-1"></i> Flagship Phones
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
            <div class="p-4 rounded-4 bg-surface border border-secondary border-opacity-20 shadow-2xl text-center">
                <div class="fs-1 mb-2">⚡</div>
                <h4 class="text-white font-heading fw-bold mb-1">Aura Phone 15 Pro Max</h4>
                <div class="text-emerald fw-bold mb-3 fs-5">28.990.000 đ</div>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge badge-spec">Titanium Grade 5</span>
                    <span class="badge badge-spec">A18 Bionic</span>
                    <span class="badge bg-emerald bg-opacity-20 text-emerald">Giảm 4 triệu</span>
                </div>
                <a href="product/1" class="btn btn-emerald w-100">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Mua Ngay Ưu Đãi
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Trust Badges Bar -->
<section class="mb-5">
    <div class="row g-3">
        <div class="col-md-3 col-6">
            <div class="p-3 rounded-4 bg-surface border border-secondary border-opacity-10 d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-indigo-500 bg-opacity-10 text-primary fs-3">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <h6 class="text-white fw-bold mb-0">Giao hàng hỏa tốc</h6>
                    <small class="text-muted">Nhận hàng trong 2H</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-3 rounded-4 bg-surface border border-secondary border-opacity-10 d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-emerald bg-opacity-10 text-emerald fs-3">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h6 class="text-white fw-bold mb-0">100% Chính hãng</h6>
                    <small class="text-muted">Bảo hành 12 tháng</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-3 rounded-4 bg-surface border border-secondary border-opacity-10 d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-warning bg-opacity-10 text-warning fs-3">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div>
                    <h6 class="text-white fw-bold mb-0">Đổi trả 30 ngày</h6>
                    <small class="text-muted">1 đổi 1 nếu có lỗi</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-3 rounded-4 bg-surface border border-secondary border-opacity-10 d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-info bg-opacity-10 text-info fs-3">
                    <i class="bi bi-headset"></i>
                </div>
                <div>
                    <h6 class="text-white fw-bold mb-0">Hỗ trợ 24/7</h6>
                    <small class="text-muted">Tư vấn chuyên sâu</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Category Selection Row -->
<section class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="text-white font-heading fw-bold mb-1">Danh Mục Nổi Bật</h3>
            <p class="text-muted small mb-0">Tìm kiếm nhanh thiết bị theo nhu cầu sử dụng</p>
        </div>
        <a href="products" class="btn btn-sm btn-outline-custom">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-3">
        @foreach (var cat in Categories)
        {
            <div class="col-md-3 col-6">
                <a href="products?cat=@Uri.EscapeDataString(cat.Name)" class="text-decoration-none">
                    <div class="p-3 rounded-4 bg-surface border border-secondary border-opacity-10 text-center hover-lift transition-all">
                        <div class="fs-2 mb-2">@cat.Icon</div>
                        <h6 class="text-white fw-bold mb-1">@cat.Name</h6>
                        <small class="text-muted">@cat.Count sản phẩm</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- Bestsellers Product Grid Section -->
<section class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="text-white font-heading fw-bold mb-1">Sản Phẩm Bán Chạy 🔥</h3>
            <p class="text-muted small mb-0">Các thiết bị công nghệ được yêu thích nhất tuần qua</p>
        </div>
        <a href="products" class="btn btn-sm btn-outline-custom">Tất cả sản phẩm <i class="bi bi-grid ms-1"></i></a>
    </div>

    <div class="row g-4">
        @foreach (var product in FeaturedProducts)
        {
            <div class="col-lg-3 col-md-6">
                <ProductCard Product="product" />
            </div>
        }
    </div>
</section>

@code {
    private List<Product> FeaturedProducts = new();
    private List<CategoryItem> Categories = new();

    protected override void OnInitialized()
    {
        var all = ProductService.GetAllProducts();
        FeaturedProducts = all.Take(4).ToList();

        Categories = new List<CategoryItem>
        {
            new CategoryItem { Name = "Điện thoại", Icon = "📱", Count = all.Count(p => p.Category == "Điện thoại") },
            new CategoryItem { Name = "Laptop", Icon = "💻", Count = all.Count(p => p.Category == "Laptop") },
            new CategoryItem { Name = "Tai nghe", Icon = "🎧", Count = all.Count(p => p.Category == "Tai nghe") },
            new CategoryItem { Name = "Phụ kiện", Icon = "⌨️", Count = all.Count(p => p.Category == "Phụ kiện") }
        };
    }

    private class CategoryItem
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public int Count { get; set; }
    }
}
