@page "/cart"
@inject CartService CartService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Giỏ Hàng (@CartCount) - NEXUS STORE</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="text-white font-heading fw-bold mb-1">Giỏ Hàng Của Bạn 🛒</h2>
        <p class="text-muted small mb-0">Xem lại danh sách sản phẩm và tiến hành thanh toán đơn hàng</p>
    </div>
    @if (CartItems.Count > 0)
    {
        <button class="btn btn-sm btn-outline-danger" @onclick="ClearCart">
            <i class="bi bi-trash me-1"></i> Xóa tất cả
        </button>
    }
</div>

@if (CartItems.Count == 0)
{
    <!-- Empty Cart View -->
    <div class="text-center py-5 my-5 rounded-4 bg-surface border border-secondary border-opacity-10">
        <div class="fs-1 mb-3 text-muted">🛍️</div>
        <h4 class="text-white font-heading fw-bold mb-2">Giỏ hàng của bạn đang trống!</h4>
        <p class="text-muted small mb-4">Hãy chọn cho mình những sản phẩm công nghệ tuyệt vời từ cửa hàng NEXUS STORE.</p>
        <a href="products" class="btn btn-accent btn-lg px-4 fs-6">
            <i class="bi bi-arrow-left me-2"></i> Khám phá sản phẩm ngay
        </a>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        
        <!-- Items List Left Column -->
        <div class="col-lg-8">
            <div class="cart-card">
                
                @foreach (var item in CartItems)
                {
                    <div class="cart-item-row">
                        
                        <!-- Visual Icon Block & Name -->
                        <div class="d-flex align-items-center gap-3" style="min-width: 240px;">
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white fs-3 shadow-sm" 
                                 style="width: 60px; height: 60px; background: @item.Product.Gradient; flex-shrink: 0;">
                                @item.Product.IconGlyph
                            </div>
                            <div>
                                <h6 class="text-white font-heading fw-bold mb-1">
                                    <a href="product/@item.Product.Id" class="text-white text-decoration-none hover-emerald">
                                        @item.Product.Name
                                    </a>
                                </h6>
                                <div class="d-flex align-items-center gap-2 small text-muted">
                                    <span>Màu: <strong class="text-white font-normal">@item.SelectedColor</strong></span>
                                    <span>•</span>
                                    <span class="text-emerald">@item.Product.Price.ToString("N0") đ</span>
                                </div>
                            </div>
                        </div>

                        <!-- Quantity Selector -->
                        <div class="d-flex align-items-center gap-2">
                            <button class="qty-btn" @onclick="() => UpdateQuantity(item.Product.Id, item.Quantity - 1)">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="px-2 fw-bold text-white" style="min-width: 30px; text-align: center;">@item.Quantity</span>
                            <button class="qty-btn" @onclick="() => UpdateQuantity(item.Product.Id, item.Quantity + 1)">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>

                        <!-- Subtotal & Delete -->
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-bold font-heading text-white fs-6">@item.SubTotal.ToString("N0") đ</span>
                            <button class="btn btn-link text-muted hover-danger p-1" 
                                    @onclick="() => RemoveItem(item.Product.Id)" 
                                    title="Xóa khỏi giỏ">
                                <i class="bi bi-trash fs-5 text-rose-400"></i>
                            </button>
                        </div>

                    </div>
                }

                <div class="pt-4 border-top border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                    <a href="products" class="btn btn-outline-custom">
                        <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
                    </a>
                    <span class="text-muted small">Tổng cộng <strong class="text-white">@CartCount</strong> sản phẩm</span>
                </div>

            </div>
        </div>

        <!-- Summary & Checkout Right Column -->
        <div class="col-lg-4">
            <div class="cart-card">
                <h5 class="text-white font-heading fw-bold mb-3">Tóm Tắt Đơn Hàng</h5>
                
                <!-- Promo Code Box -->
                <div class="mb-3">
                    <label class="form-label text-muted small">Mã giảm giá (Thử: <strong class="text-emerald">NEXUS2026</strong>):</label>
                    <div class="input-group">
                        <input type="text" class="form-control input-custom" placeholder="Nhập mã..." @bind="PromoCode" />
                        <button class="btn btn-outline-custom" type="button" @onclick="ApplyPromo">Áp dụng</button>
                    </div>
                    @if (IsPromoApplied)
                    {
                        <small class="text-emerald d-block mt-1"><i class="bi bi-check-circle me-1"></i> Đã giảm 10% tổng đơn hàng!</small>
                    }
                    @if (PromoError != null)
                    {
                        <small class="text-rose-400 d-block mt-1"><i class="bi bi-exclamation-circle me-1"></i> @PromoError</small>
                    }
                </div>

                <!-- Price Rows -->
                <div class="d-flex justify-content-between text-muted small mb-2">
                    <span>Tạm tính:</span>
                    <span class="text-white fw-semibold">@SubTotal.ToString("N0") đ</span>
                </div>

                <div class="d-flex justify-content-between text-muted small mb-2">
                    <span>Phí vận chuyển:</span>
                    <span class="text-emerald fw-semibold">@(ShippingFee == 0 ? "Miễn phí" : ShippingFee.ToString("N0") + " đ")</span>
                </div>

                @if (DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Giảm giá khuyến mãi:</span>
                        <span class="text-rose-400 fw-semibold">-@DiscountAmount.ToString("N0") đ</span>
                    </div>
                }

                <hr class="border-secondary border-opacity-20 my-3" />

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="text-white fw-bold fs-6">Tổng thanh toán:</span>
                    <span class="font-heading fw-extrabold text-emerald fs-3">@FinalTotal.ToString("N0") <small class="fs-6">đ</small></span>
                </div>

                <!-- Checkout Button -->
                <button class="btn btn-emerald btn-lg w-100 py-3 shadow-lg" @onclick="ProcessCheckout">
                    <i class="bi bi-credit-card-fill me-2"></i> Tiến Hành Thanh Toán
                </button>

                <div class="mt-3 text-center text-muted" style="font-size: 0.75rem;">
                    <i class="bi bi-lock-fill me-1"></i> Bảo mật thanh toán SSL 256-bit
                </div>

            </div>
        </div>

    </div>
}

<!-- Checkout Success Modal Dialog -->
@if (ShowOrderSuccessModal)
{
    <div class="modal fade show d-block backdrop-blur" tabIndex="-1" style="background: rgba(9, 13, 25, 0.85);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-card border border-emerald rounded-4 text-white p-4 shadow-2xl">
                <div class="text-center py-3">
                    <div class="rounded-circle bg-emerald bg-opacity-20 text-emerald d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-check-lg fs-1"></i>
                    </div>
                    <h4 class="font-heading fw-bold mb-2">Đặt Hàng Thành Công!</h4>
                    <p class="text-muted small mb-3">Cảm ơn bạn đã trải nghiệm mua sắm demo tại NEXUS STORE.</p>
                    
                    <div class="p-3 rounded-3 bg-surface border border-secondary border-opacity-10 mb-4 text-start small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Mã đơn hàng:</span>
                            <strong class="text-emerald">#NEXUS-@RandomOrderId</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tổng thanh toán:</span>
                            <strong class="text-white">@FinalTotal.ToString("N0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Trạng thái:</span>
                            <span class="badge bg-emerald bg-opacity-20 text-emerald">Đang chuẩn bị hàng</span>
                        </div>
                    </div>

                    <button class="btn btn-accent w-100 py-2.5" @onclick="CloseModal">
                        Quay về trang chủ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<CartItem> CartItems => CartService.GetCartItems();
    private int CartCount => CartService.GetTotalCount();
    private decimal SubTotal => CartService.GetTotal();
    private decimal ShippingFee => SubTotal > 10000000 || SubTotal == 0 ? 0 : 30000;
    
    private string PromoCode = "";
    private bool IsPromoApplied = false;
    private string? PromoError;
    private decimal DiscountAmount => IsPromoApplied ? SubTotal * 0.1m : 0;
    private decimal FinalTotal => Math.Max(0, SubTotal + ShippingFee - DiscountAmount);

    private bool ShowOrderSuccessModal = false;
    private string RandomOrderId = "";

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    private void UpdateQuantity(int productId, int qty)
    {
        CartService.UpdateQuantity(productId, qty);
    }

    private void RemoveItem(int productId)
    {
        CartService.RemoveFromCart(productId);
    }

    private void ClearCart()
    {
        CartService.ClearCart();
        IsPromoApplied = false;
    }

    private void ApplyPromo()
    {
        PromoError = null;
        if (PromoCode.Trim().Equals("NEXUS2026", StringComparison.OrdinalIgnoreCase))
        {
            IsPromoApplied = true;
        }
        else
        {
            IsPromoApplied = false;
            PromoError = "Mã giảm giá không hợp lệ. Vui lòng thử NEXUS2026";
        }
    }

    private void ProcessCheckout()
    {
        RandomOrderId = new Random().Next(100000, 999999).ToString();
        ShowOrderSuccessModal = true;
    }

    private void CloseModal()
    {
        ShowOrderSuccessModal = false;
        CartService.ClearCart();
        NavigationManager.NavigateTo("");
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
