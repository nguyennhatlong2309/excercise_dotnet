<!DOCTYPE html>
<html lang="vi" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["examBlazor.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        (function() {
            var theme = localStorage.getItem('nexus_theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
        window.setAppTheme = function(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('nexus_theme', theme);
        };
        window.getAppTheme = function() {
            return localStorage.getItem('nexus_theme') || 'light';
        };

        window.uiAnnotatorState = { active: false, dotNetRef: null, highlightedEl: null };
        window.initUiAnnotator = function(dotNetRef) {
            window.uiAnnotatorState.dotNetRef = dotNetRef;
            document.addEventListener('mousemove', function(e) {
                if (!window.uiAnnotatorState.active) return;
                if (e.target.closest('.ui-annotator-container')) return;
                var prev = window.uiAnnotatorState.highlightedEl;
                if (prev && prev !== e.target) {
                    prev.style.outline = '';
                    prev.style.outlineOffset = '';
                }
                window.uiAnnotatorState.highlightedEl = e.target;
                e.target.style.outline = '2px dashed #6366f1';
                e.target.style.outlineOffset = '2px';
            });
            document.addEventListener('click', function(e) {
                if (!window.uiAnnotatorState.active) return;
                if (e.target.closest('.ui-annotator-container')) return;
                e.preventDefault();
                e.stopPropagation();
                var target = e.target;
                if (window.uiAnnotatorState.highlightedEl) {
                    window.uiAnnotatorState.highlightedEl.style.outline = '';
                    window.uiAnnotatorState.highlightedEl.style.outlineOffset = '';
                    window.uiAnnotatorState.highlightedEl = null;
                }
                var sel = target.id ? '#' + target.id : target.tagName.toLowerCase() + (target.className && typeof target.className === 'string' ? '.' + target.className.trim().split(/\s+/).filter(function(c){return c && !c.includes(':');}).slice(0, 2).join('.') : '');
                var txt = (target.innerText || target.placeholder || target.value || target.tagName).substring(0, 50).trim();
                window.uiAnnotatorState.dotNetRef.invokeMethodAsync('OnElementSelected', {
                    selector: sel,
                    textPreview: txt,
                    pageX: e.pageX,
                    pageY: e.pageY
                });
            }, true);
        };
        window.toggleUiAnnotator = function(isActive) {
            window.uiAnnotatorState.active = isActive;
            if (!isActive && window.uiAnnotatorState.highlightedEl) {
                window.uiAnnotatorState.highlightedEl.style.outline = '';
                window.uiAnnotatorState.highlightedEl.style.outlineOffset = '';
                window.uiAnnotatorState.highlightedEl = null;
            }
        };
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
